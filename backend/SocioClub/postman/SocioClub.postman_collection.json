          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 Conflict', function () { pm.response.to.have.status(409); });", "pm.test('Mensaje RN4', function () { pm.expect(pm.response.json().mensaje).to.eql('Debe regularizar su cuota en secretaría'); });"] } }]
